<?xml version="1.0" encoding="UTF-8"?>
<manifest>

    <!-- Remotes -->
    <remote name="zenin"
            fetch="https://github.com/sm8635-dev"
            clone-depth="1" />

    <remote name="codeberg"
            fetch="https://codeberg.org/zenin1504"
            clone-depth="1" />

    <remote name="evox"
            fetch="https://github.com/evolution-x-devices"
            clone-depth="1" />

    <!-- Device Tree -->
    <project path="device/xiaomi/peridot"
             name="device_xiaomi_peridot"
             remote="evox"
             revision="bka" />

    <!-- Kernel Source -->
    <project path="kernel/xiaomi/sm8635"
             name="kernel_xiaomi_sm8635"
             remote="evox"
             revision="bka" />

    <project path="kernel/xiaomi/sm8635-devicetrees"
             name="kernel_xiaomi_sm8635-devicetrees"
             remote="evox"
             revision="bka" />

    <project path="kernel/xiaomi/sm8635-modules"
             name="kernel_xiaomi_sm8635-modules"
             remote="evox"
             revision="bka" />

    <!-- Vendor Blobs -->
    <project path="vendor/xiaomi/peridot"
             name="vendor_xiaomi_peridot"
             remote="evox"
             revision="bka" />

    <!-- HALs and Policies -->
    <project path="hardware/xiaomi"
             name="hardware_xiaomi"
             remote="zenin"
             revision="bka" />

</manifest>
