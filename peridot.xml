<?xml version="1.0" encoding="UTF-8"?>
<manifest>

    <!-- Remotes -->
    <remote name="zenin"
            fetch="https://github.com/sm8635-dev"
            clone-depth="1" />

    <!--
    <remote name="gitlab-zenin"
            fetch="https://gitlab.com/sm8635-dev"
            clone-depth="1" />
    -->

    <remote name="lineage-audio"
            fetch="https://github.com/LineageOS" />

    <!-- Remove existing audio hals -->
    <remove-project path="hardware/qcom-caf/sm8650/audio/agm" />
    <remove-project path="hardware/qcom-caf/sm8650/audio/graphservices" />
    <remove-project path="hardware/qcom-caf/sm8650/audio/pal" />
    <remove-project path="hardware/qcom-caf/sm8650/audio/primary-hal" />

    <!-- Audio hals -->
    <project path="hardware/qcom-caf/sm8650/audio/agm"
             name="android_vendor_qcom_opensource_agm"
             remote="lineage-audio"
             revision="lineage-23.2-caf-sm8650" />

    <project path="hardware/qcom-caf/sm8650/audio/graphservices"
             name="android_vendor_qcom_opensource_audioreach-graphservices"
             remote="lineage-audio"
             revision="lineage-23.2-caf-sm8650" />

    <project path="hardware/qcom-caf/sm8650/audio/pal"
             name="android_vendor_qcom_opensource_arpal-lx"
             remote="lineage-audio"
             revision="lineage-23.2-caf-sm8650" />

    <project path="hardware/qcom-caf/sm8650/audio/primary-hal"
             name="android_hardware_qcom_audio-ar"
             remote="lineage-audio"
             revision="lineage-23.2-caf-sm8650" />

    <!-- Device Tree -->
    <project path="device/xiaomi/peridot"
             name="device_xiaomi_peridot"
             remote="zenin"
             revision="sixteen" />

    <!-- Kernel Source -->
    <project path="kernel/xiaomi/sm8635"
             name="kernel_xiaomi_sm8635"
             remote="zenin"
             revision="sixteen" />

    <project path="kernel/xiaomi/sm8635-devicetrees"
             name="kernel_xiaomi_sm8635-devicetrees"
             remote="zenin"
             revision="sixteen" />

    <project path="kernel/xiaomi/sm8635-modules"
             name="kernel_xiaomi_sm8635-modules"
             remote="zenin"
             revision="sixteen" />

    <!-- Vendor Blobs -->
    <!--
    <project path="vendor/xiaomi/peridot"
             name="vendor_xiaomi_peridot"
             remote="gitlab-zenin"
             revision="sixteen" />
    -->

    <!-- HALs and Policies -->
    <project path="hardware/xiaomi"
             name="hardware_xiaomi"
             remote="zenin"
             revision="sixteen" />

    <!-- Apps -->
    <project path="packages/apps/FastCharge"
             name="packages_apps_FastCharge"
             remote="zenin"
             revision="sixteen" />

    <project path="packages/apps/XiaomiParts"
             name="packages_apps_XiaomiParts"
             remote="zenin"
             revision="sixteen" />

</manifest>
