<?xml version="1.0" encoding="UTF-8"?>
<manifest>

    <!-- Remotes -->
    <remote name="zenin"
            fetch="https://github.com/sm8635-dev"
            clone-depth="1" />

    <remote name="yaap"
            fetch="https://github.com/YAAP"
            clone-depth="1" />

    <remote name="codeberg"
            fetch="https://codeberg.org/zenin1504"
            clone-depth="1" />

    <!-- Device Tree -->
    <project path="device/xiaomi/peridot"
             name="device_xiaomi_peridot"
             remote="zenin"
             revision="pos-unofficial" />

    <!-- Dolby -->
    <project path="vendor/sony/dolby"
             name="vendor_sony_dolby"
             remote="zenin"
             revision="sixteen" />

    <!-- Kernel Source -->
    <project path="kernel/xiaomi/sm8635"
             name="kernel_xiaomi_sm8635"
             remote="zenin"
             revision="rebase" />

    <project path="kernel/xiaomi/sm8635-devicetrees"
             name="kernel_xiaomi_sm8635-devicetrees"
             remote="zenin"
             revision="pos-unofficial" />

    <project path="kernel/xiaomi/sm8635-modules"
             name="kernel_xiaomi_sm8635-modules"
             remote="zenin"
             revision="pos-unofficial" />

    <!-- Miui Camera -->
    <project path="device/xiaomi/peridot-miuicamera"
             name="device_xiaomi_peridot-miuicamera"
             remote="zenin"
             revision="pos-unofficial" />

    <project path="vendor/xiaomi/peridot-miuicamera"
             name="vendor_xiaomi_peridot-miuicamera"
             remote="zenin"
             revision="pos-unofficial" />

    <!-- Vendor Blobs -->
    <project path="vendor/xiaomi/peridot"
             name="vendor_xiaomi_peridot"
             remote="codeberg"
             revision="pos-unofficial" />

    <!-- HALs and Policies -->
    <project path="hardware/xiaomi"
             name="hardware_xiaomi"
             remote="zenin"
             revision="pos-unofficial" />

    <!-- KProfiles -->
    <project path="packages/apps/Kprofiles"
             name="packages_apps_KProfiles"
             remote="yaap"
             revision="sixteen" />

</manifest>
